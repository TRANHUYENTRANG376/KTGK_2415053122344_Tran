<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ CHI TIÊU CÁ "
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên khoản chi"/>
        <EditText
            android:id="@+id/edtTenKhoanChi_344"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ví dụ: Ăn uống"
            android:inputType="textCapSentences"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số tiền"/>
        <EditText
            android:id="@+id/edtSoTien_344"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập số tiền (VND)"
            android:inputType="numberDecimal"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ghi chú"/>
        <EditText
            android:id="@+id/edtGhiChu_344"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập ghi chú"
            android:inputType="textCapSentences"
            android:minLines="2"/>
        <Button
            android:id="@+id/btnThemKhoanChi_344"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm khoản chi"
            android:layout_marginTop="20dp"/>
        <Button
            android:id="@+id/btnXemChiTiet_344"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xem chi tiết khoản chi"/>
    </LinearLayout>
</ScrollView>